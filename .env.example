# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/vegabytes_db

# ── Proxy Configuration ───────────────────────────────────
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
# Comma-separated list of residential proxy endpoints
PROXY_LIST=

# ── LLM / AI DOM Parser ───────────────────────────────────
GEMINI_API_KEY=

# ── Telegram Alerting ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Scraper Config ────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=240
MAX_RETRIES=3
REQUEST_DELAY_SECONDS=30
HEADLESS=true

# ── API Server ────────────────────────────────────────────
API_SECRET_KEY=changeme_use_secrets_manager_in_prod
API_HOST=0.0.0.0
API_PORT=8000
